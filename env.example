# Скопируйте в .env и впишите ключ OpenRouter: cp env.example .env
TZCHECK_LLM_MODEL=openrouter/deepseek/deepseek-v4.1-flash
TZCHECK_LLM_API_KEY=
# вторая модель второй проверки: в основной список идёт то, что подтвердили обе модели; пусто = одна модель
TZCHECK_VERIFY2_MODEL=openrouter/qwen/qwen3.8-27b
# образцы кейса и ТЗ из ЕИС открытые: разрешить внешнюю модель без слоя NER (раздел «Маскирование ПД»)
TZCHECK_DOC_PUBLIC=1
# закрытый документ во внешнюю модель только с разрешения заказчика и при доступном маскировании ПД: 1 = разрешено
TZCHECK_EXTERNAL_MASKED=0
